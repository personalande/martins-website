# Ferragens Martins Website — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA comite .env.local para o repositório.

# ============================================================
# SITE
# ============================================================

# URL pública do site (sem barra no final)
# Obrigatório para: canonical URLs, Open Graph, redirects, cookies
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nome do site (usado em meta tags e PDF)
NEXT_PUBLIC_SITE_NAME=Ferragens Martins

# ============================================================
# SUPABASE
# ============================================================

# URL do projeto Supabase
# Encontre em: Project Settings > API > Project URL
# Obrigatório
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (pública, sem privilégios elevados)
# Encontre em: Project Settings > API > anon/public key
# Obrigatório
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (PRIVADA - nunca prefixar com NEXT_PUBLIC_)
# Encontre em: Project Settings > API > service_role key
# Usada APENAS em Server Actions e Route Handlers privilegiados
# NUNCA expor no bundle do cliente
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# WHATSAPP (padrão — pode ser sobrescrito por loja)
# ============================================================

# Número no formato internacional sem + ou espaços
# Loja 1 — Vila São Vicente
NEXT_PUBLIC_WHATSAPP_LOJA1=5541992557256

# Loja 2 — Vila Itiberê
NEXT_PUBLIC_WHATSAPP_LOJA2=5541989001321

# Número padrão de fallback
NEXT_PUBLIC_DEFAULT_WHATSAPP=5541992557256

# ============================================================
# TELEFONES
# ============================================================

NEXT_PUBLIC_PHONE_LOJA1=(41) 9 9255-7256
NEXT_PUBLIC_PHONE_LOJA2=(41) 9 8900-1321

# ============================================================
# GOOGLE MAPS (opcional)
# ============================================================

# Chave de API para Google Maps Embed
# Se vazia, usa apenas links para maps.google.com
# Restringir para: Maps Embed API, referrer do domínio
GOOGLE_MAPS_EMBED_API_KEY=

# ============================================================
# PDF
# ============================================================

# Segredo para assinar URLs de PDFs gerados
# Gere com: openssl rand -base64 32
# Obrigatório para geração de PDF em produção
PDF_SIGNING_SECRET=

# ============================================================
# RATE LIMITING (opcional — Upstash Redis)
# ============================================================

# Se vazio, usa rate limiting em memória (não recomendado para produção)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# E-MAIL (opcional — notificações de orçamento)
# ============================================================

# E-mail para receber notificações de novas solicitações
CONTACT_NOTIFICATION_EMAIL=

# Provedor de e-mail transacional
# Opções: resend, sendgrid, ses
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# ============================================================
# ANALYTICS (opcional)
# ============================================================

# Habilitar envio de eventos (apenas eventos sem PII)
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Google Analytics 4 - Measurement ID (G-XXXXXXXXXX)
# Carregado SOMENTE se ANALYTICS_ENABLED=true e consentimento do usuário
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ============================================================
# MONITORAMENTO DE ERROS (opcional)
# ============================================================

# Sentry — DSN do projeto
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ============================================================
# AMBIENTE
# ============================================================

# Ambiente de execução (development | preview | production)
# Definido automaticamente pela Vercel
NODE_ENV=development
